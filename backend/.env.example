# Smart Hospital Triage — Environment Example
# Copy to .env and adjust. Never commit real secrets.
SECRET_KEY=""""
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# SQLite default (demo). For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_triage
DATABASE_URL=sqlite:///./smart_triage.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEMO_MODE=true
